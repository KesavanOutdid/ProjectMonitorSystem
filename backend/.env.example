# Project Monitor System - Backend Configuration Template
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project_monitor_system?retryWrites=true&w=majority

# Redis Configuration (Optional, set REDIS_ENABLED=false to bypass)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Optional AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Email / SMTP Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@outdidunified.com
SMTP_PASS=your_app_password
EMAIL_FROM="Project Monitor" <info@outdidunified.com>
