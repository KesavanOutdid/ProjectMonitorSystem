# =============================================================
# Root Docker Environment Configuration Template
# =============================================================
NODE_ENV=production

# Backend & Socket IP configuration for Linode
NEXT_PUBLIC_BACKEND_IP=127.0.0.1
NEXT_PUBLIC_BACKEND_PORT=5000
NEXT_PUBLIC_BACKEND_PROTOCOL=http

NEXT_PUBLIC_SOCKET_IP=127.0.0.1
NEXT_PUBLIC_SOCKET_PORT=5000
NEXT_PUBLIC_SOCKET_PROTOCOL=http

# Redis IP / Host in Container Network
REDIS_HOST=redis
REDIS_PORT=6379
