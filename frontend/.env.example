# =============================================================
# Project Monitor System - Frontend Environment Variables
# =============================================================

# Option A: Discrete IPs & Ports (Individual Configuration)
NEXT_PUBLIC_BACKEND_IP=localhost
NEXT_PUBLIC_BACKEND_PORT=5000
NEXT_PUBLIC_BACKEND_PROTOCOL=http

NEXT_PUBLIC_SOCKET_IP=localhost
NEXT_PUBLIC_SOCKET_PORT=5000
NEXT_PUBLIC_SOCKET_PROTOCOL=http

# Option B: Full URL Configuration (Alternative)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Informational / Redis Service Config (used if connecting directly)
NEXT_PUBLIC_REDIS_HOST=127.0.0.1
NEXT_PUBLIC_REDIS_PORT=6379

NEXT_PUBLIC_APP_NAME="Project Monitor System"
