# =============================================================
# Production Environment - Linode Cloud / Custom Domain / VM
# =============================================================

# Enter your Linode Public IP or Domain (e.g. 172.105.x.x or pms.yourdomain.com)
NEXT_PUBLIC_BACKEND_IP=
NEXT_PUBLIC_BACKEND_PORT=5000
NEXT_PUBLIC_BACKEND_PROTOCOL=http

# Socket IP (Same as Backend IP unless running on dedicated socket cluster)
NEXT_PUBLIC_SOCKET_IP=
NEXT_PUBLIC_SOCKET_PORT=5000
NEXT_PUBLIC_SOCKET_PROTOCOL=http

# Redis Host in Production Network (internal container name or Linode private IP)
NEXT_PUBLIC_REDIS_HOST=redis
NEXT_PUBLIC_REDIS_PORT=6379

NEXT_PUBLIC_APP_NAME="Project Monitor System"
